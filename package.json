{
  "name": "awesome-opencode",
  "version": "1.0.0",
  "description": "A curated, validated catalog of OpenCode plugins, themes, agents, MCP servers, clients and resources",
  "private": true,
  "scripts": {
    "validate": "node scripts/validate.js",
    "generate": "node scripts/generate-readme.js",
    "export": "node scripts/export-json.js --pretty --output dist/registry.json",
    "new": "node scripts/new-entry.js",
    "fmt": "node scripts/fmt.js",
    "check-pr": "node scripts/check-pr.js --base origin/main",
    "health": "node scripts/health-check.js --dry-run",
    "scout": "node scripts/scout.js run --dry-run",
    "site": "node scripts/build-site.js",
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "opencode",
    "awesome-list",
    "plugins",
    "themes",
    "agents",
    "mcp"
  ],
  "license": "CC0-1.0",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
